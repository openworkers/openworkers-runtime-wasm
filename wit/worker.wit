package openworkers:worker@0.2.0;

/// Cron entry point; wasi:http/proxy has no equivalent for it
interface scheduled {
    /// Handle a scheduled event (unix timestamp in ms)
    handle-scheduled: func(scheduled-time: u64);
}

/// Full OpenWorkers guest: the standard wasi:http proxy plus cron.
/// Guests that only serve HTTP can target wasi:http/proxy directly and
/// run unmodified; the scheduled export is then simply absent.
world worker {
    include wasi:http/proxy@0.2.12;
    export scheduled;
}

/// Host-side view of the cron export alone; the HTTP side is bound
/// through the wasi:http host implementation
world scheduled-only {
    export scheduled;
}
